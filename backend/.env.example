OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_SSL=
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_EXPIRE_MINUTES=360
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small
# Google OAuth (used by /api/v1/auth/google/login and /api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
